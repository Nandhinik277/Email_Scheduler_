generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Email {
  id          Int      @id @default(autoincrement())
  recipient   String
  subject     String
  body        String
  scheduledAt DateTime
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}